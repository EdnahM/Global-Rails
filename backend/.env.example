# ============================================================
# African Rails MCP - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Wallet (REQUIRED) ---
# Your EVM private key (hex string starting with 0x)
# This wallet pays gas fees and signs x402 payments.
PRIVATE_KEY=0xyour_private_key_here

# Pre-derived wallet address (must match PRIVATE_KEY)
WALLET_ADDRESS=0xyour_wallet_address_here

# --- Network ---
# "celo" (default) or "ethereum"
DEFAULT_CHAIN=celo

# --- RPC Endpoints (optional overrides) ---
ETHEREUM_RPC_URL=https://eth.llamarpc.com
CELO_RPC_URL=https://forno.celo.org

# --- CoinGecko (optional) ---
# Leave empty to use free demo tier (rate-limited)
# Get a Pro key at https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# --- x402 Micropayments ---
# Maximum USD amount the agent can spend per x402 payment
X402_MAX_SPEND_USD=1.0
